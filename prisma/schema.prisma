generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String          @id @default(cuid())
  username                  String          @unique
  email                     String?
  password                  String
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  characterClass            String          @default("Scout")
  characterRace             String          @default("Human")
  currentRoom               String          @default("001")
  recallRoom                String          @default("001")
  lastActive                DateTime        @default(now())
  isActive                  Boolean         @default(true)
  clicks                    Int             @default(0)
  deaths                    Int             @default(0)
  level                     Int             @default(1)
  xp                        Int             @default(0)
  cp                        Int             @default(0)
  tp                        Int             @default(0)
  sp                        Int             @default(0)
  currency                  Int             @default(3)
  str                       Int             @default(0)
  dex                       Int             @default(0)
  mag                       Int             @default(0)
  def                       Int             @default(0)
  strMod                    Int             @default(0)
  dexMod                    Int             @default(0)
  magMod                    Int             @default(0)
  defMod                    Int             @default(0)
  physicalTraining          Int             @default(1)
  mentalTraining            Int             @default(0)
  oneHanded                 Int             @default(0)
  twoHanded                 Int             @default(0)
  ranged                    Int             @default(0)
  warcraft                  Int             @default(0)
  toughness                 Int             @default(0)
  block                     Int             @default(0)
  dodge                     Int             @default(0)
  slice                     Int             @default(0)
  smash                     Int             @default(0)
  aim                       Int             @default(0)
  magicStrike               Int             @default(0)
  multiArrow                Int             @default(0)
  boltUpgrade               Int             @default(0)
  throwDagger               Int             @default(0)
  crafting                  Int             @default(0)
  magicMissile              Int             @default(0)
  fireball                  Int             @default(0)
  poisonDart                Int             @default(0)
  magicArrow                Int             @default(0)
  atomicBlast               Int             @default(0)
  meteor                    Int             @default(0)
  heal                      Int             @default(0)
  regenerate                Int             @default(0)
  antidote                  Int             @default(0)
  unlock                    Int             @default(0)
  ironSkin                  Int             @default(0)
  magicArmor                Int             @default(0)
  wings                     Int             @default(0)
  gills                     Int             @default(0)
  buffStrClicks             Int             @default(0)
  buffDexClicks             Int             @default(0)
  buffMagClicks             Int             @default(0)
  buffDefClicks             Int             @default(0)
  buffCoffeeClicks          Int             @default(0)
  /// Bathing in the Master Water Temple's glory: +30 to every core stat while it counts down.
  buffGloryClicks           Int             @default(0)
  /// The Silver Shaman's aura, learned in a full Silver set: a standing +20 to every core stat.
  silverAura                Boolean         @default(false)
  hp                        Int             @default(10)
  hpMax                     Int             @default(10)
  mp                        Int             @default(2)
  mpMax                     Int             @default(2)
  inFight                   Boolean         @default(false)
  endFight                  Boolean         @default(false)
  weaponType                Int             @default(0)
  theme                     String          @default("light-gray")
  uIcon                     String          @default("char-commander")
  uIconColor                String          @default("#60a5fa")
  uIconWeapon               String          @default("fists")
  eIcon                     String          @default("question")
  chest1                    Boolean         @default(false)
  chest2                    Boolean         @default(false)
  chest3                    Boolean         @default(false)
  chest4                    Boolean         @default(false)
  chest5                    Boolean         @default(false)
  chest6                    Boolean         @default(false)
  chest7                    Boolean         @default(false)
  chest8                    Boolean         @default(false)
  chest9                    Boolean         @default(false)
  chest10                   Boolean         @default(false)
  roomZeroMap               Boolean         @default(false)
  grassyFieldMap            Boolean         @default(false)
  grassyFieldUndergroundMap Boolean         @default(false)
  forestMap                 Boolean         @default(false)
  forestUndergroundMap      Boolean         @default(false)
  redTownMap                Boolean         @default(false)
  redTownSewersMap          Boolean         @default(false)
  rockyFlatsMap             Boolean         @default(false)
  rockyFlatsUndergroundMap  Boolean         @default(false)
  neverEndingMineMap        Boolean         @default(false)
  oceanMap                  Boolean         @default(false)
  oceanUnderwaterMap        Boolean         @default(false)
  darkForestMap             Boolean         @default(false)
  darkForestUpperMap        Boolean         @default(false)
  worldMapV1                Boolean         @default(false)
  worldMapV2                Boolean         @default(false)
  worldMapV3                Boolean         @default(false)
  worldMapV4                Boolean         @default(false)
  worldMapV5                Boolean         @default(false)
  worldMapFull              Boolean         @default(false)
  lobbyMap                  Boolean         @default(false)
  solarOfficeMap            Boolean         @default(false)
  /// Fast-travel hubs this player has stood in, by world region id (game-data/world-map.js).
  discoveredTeleports       String[]        @default([])
  pajamaShamanFlag          Boolean         @default(false)
  youngSoldierFlag          Boolean         @default(false)
  jackLumberFlag            Boolean         @default(false)
  hunterBillFlag            Boolean         @default(false)
  travelingWarriorFlag      Boolean         @default(false)
  travelingWizardFlag       Boolean         @default(false)
  warriorSkillFlag          Boolean         @default(false)
  wizardSkillFlag           Boolean         @default(false)
  miningSkillFlag           Boolean         @default(false)
  rangerSkillFlag           Boolean         @default(false)
  masterTrainerFlag         Boolean         @default(false)
  starCitySkillsFlag        Boolean         @default(false)
  starCitySpellsFlag        Boolean         @default(false)
  dailyChestLast            Int             @default(0)
  dailyChestNextAvailable   Int             @default(0)
  dailyChestCount           Int             @default(0)
  accounts                  Account[]
  actionHistory             ActionHistory[]
  battleLogs                BattleLog[]
  chatMessages              ChatMessage[]
  roomChatMessages          RoomChatMessage[]
  sentDMs                   DirectMessage[] @relation("SentDMs")
  receivedDMs               DirectMessage[] @relation("ReceivedDMs")
  threadsAsA                DirectThread[]  @relation("ThreadsAsA")
  threadsAsB                DirectThread[]  @relation("ThreadsAsB")
  worldFeedEvents           WorldFeedEvent[]
  equipment                 Equipment?
  killList                  KillList[]
  playerRoomEnemies         PlayerRoomEnemy[]
  PlayerItem                PlayerItem[]
  quests                    QuestProgress[]
  giversMet                 GiverMet[]
  sessions                  Session[]
  actionCaps                ActionCap[]
  room                      Room            @relation("RoomPlayers", fields: [currentRoom], references: [roomId])
}

model Equipment {
  id        String @id @default(cuid())
  userId    String @unique
  rightHand String @default("fists")
  leftHand  String @default("- - -")
  head      String @default("- - -")
  body      String @default("- - -")
  hands     String @default("- - -")
  feet      String @default("- - -")
  ring1     String @default("- - -")
  ring2     String @default("- - -")
  neck      String @default("- - -")
  artifact  String @default("- - -")
  tech      String @default("- - -")
  companion String @default("- - -")
  pet       String @default("- - -")
  mount     String @default("- - -")
  robot     String @default("- - -")
  aura      String @default("- - -")
  arrows    Int    @default(0)
  bolts     Int    @default(0)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KillList {
  id      String @id @default(cuid())
  userId  String
  monster String
  kills   Int    @default(0)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, monster])
}

// Persists the one enemy present for a player in a room so it survives a page
// refresh / reconnect. Prevents the "refresh to reset the room" exploit: on login
// the same enemy is restored (full-HP battle) instead of rolling a fresh,
// potentially easier/empty room. The row is deleted when the enemy is defeated
// or abandoned. One enemy per room per player, as in the original.
model PlayerRoomEnemy {
  id         String   @id @default(cuid())
  userId     String
  roomId     String
  enemySlug  String
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@index([userId])
}

model GiverMet {
  id      String   @id @default(cuid())
  userId  String
  giverId String
  metAt   DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, giverId])
  @@index([userId])
}

model QuestProgress {
  id        String  @id @default(cuid())
  userId    String
  questId   String
  progress  Int     @default(0)
  completed Boolean @default(false)
  data      Json?
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
}

model Room {
  id               String     @id @default(cuid())
  roomId           String     @unique
  name             String
  description      String
  dangerLevel      Int        @default(0)
  isSafe           Boolean    @default(true)
  north            String?
  northeast        String?
  east             String?
  southeast        String?
  south            String?
  southwest        String?
  west             String?
  northwest        String?
  up               String?
  down             String?
  hasFire          Boolean    @default(false)
  hasCraftingTable Boolean    @default(false)
  hasSearch        Boolean    @default(false)
  subtitle         String     @default("This is it. The world is yours.")
  subtitlePosition String     @default("below")
  /**
   * Which world region this room belongs to, driving its themed colours.
   * The four *Color fields below are per-room overrides on top of it, and hold
   * semantic token names (`terrain.dirt`, `world.redTown`) rather than CSS
   * classes — see src/lib/theme/room-colors.ts.
   */
  region           String     @default("grassyField")
  nameColor        String?
  subtitleColor    String?
  icon             String?
  iconColor        String?
  iconSize         String?
  directionColors   Json?
  npcs             NPC[]
  items            RoomItem[]
  players          User[]     @relation("RoomPlayers")
  roomChatMessages RoomChatMessage[]
}

model RoomItem {
  id             String       @id @default(cuid())
  roomId         String
  quantity       Int          @default(1)
  maxQuantity    Int?
  respawnSeconds Int?
  autoRespawn    Boolean      @default(false)
  templateId     String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())
  room           Room         @relation(fields: [roomId], references: [roomId], onDelete: Cascade)
  ItemTemplate   ItemTemplate @relation(fields: [templateId], references: [id])
}

model NPC {
  id          String @id @default(cuid())
  roomId      String
  name        String
  description String
  type        String
  room        Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  message   String
  timestamp DateTime @default(now())
  roomId    String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RoomChatMessage {
  id        String   @id @default(cuid())
  userId    String
  roomId    String
  message   String
  type      String?  @default("chat")
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room      Room     @relation(fields: [roomId], references: [roomId], onDelete: Cascade)

  @@index([roomId, timestamp])
}

model DirectMessage {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  message     String
  createdAt   DateTime @default(now())
  readAt      DateTime?
  sender      User     @relation("SentDMs", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User     @relation("ReceivedDMs", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt, createdAt])
}

model DirectThread {
  id                 String   @id @default(cuid())
  userAId            String
  userBId            String
  lastMessageAt      DateTime @default(now())
  lastMessageSnippet String   @default("")
  userAUnreadCount   Int      @default(0)
  userBUnreadCount   Int      @default(0)
  userA              User     @relation("ThreadsAsA", fields: [userAId], references: [id], onDelete: Cascade)
  userB              User     @relation("ThreadsAsB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
}

model WorldFeedEvent {
  id        String   @id @default(cuid())
  userId    String
  username  String
  eventType String
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([timestamp])
  @@index([eventType])
}

model ActionHistory {
  id        String   @id @default(cuid())
  userId    String
  action    String
  message   String
  timestamp DateTime @default(now())
  roomId    String?
  metadata  String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ItemTemplate {
  id           String       @id
  slug         String       @unique
  name         String
  description  String
  type         ItemType
  max          Int          @default(99)
  weight       Float?
  value        Int          @default(10)
  canSell      Boolean      @default(true)
  canDrop      Boolean      @default(true)
  equipSlot      EquipSlot?
  weaponCategory WeaponCategory?
  metadata       Json?
  PlayerItem   PlayerItem[]
  RoomItem     RoomItem[]
}

// One row per (player, item template) — a stack, with `isEquipped` flipped on the
// stack row rather than split into a separate row. That was always the intended
// invariant but nothing enforced it, so concurrent grants (a backgrounded battle
// drop racing a pickup or purchase) could create a second row for the same
// template; `removeItemBySlug` only ever sees the first, so quantity gates and
// consumes then misbehave. The unique constraint makes the invariant real and
// lets grants be a single atomic upsert.
model PlayerItem {
  id           String       @id
  playerId     String
  templateId   String
  quantity     Int          @default(1)
  isEquipped   Boolean      @default(false)
  slot         String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now())
  User         User         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  ItemTemplate ItemTemplate @relation(fields: [templateId], references: [id])

  @@unique([playerId, templateId])
  @@index([playerId])
}

model BattleLog {
  id                  String   @id @default(cuid())
  userId              String
  enemySlug           String
  enemyName           String
  outcome             String
  turnsCount          Int
  totalDamageDealt    Int
  totalDamageReceived Int
  maxSingleHit        Int
  xpEarned            Int
  goldEarned          Int
  itemsDropped        Json     @default("[]")
  multiplayerBonus    Boolean  @default(false)
  createdAt           DateTime @default(now())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ActionCap {
  id             String   @id @default(cuid())
  playerId       String
  roomId         String
  actionKey      String
  usedCount      Int      @default(0)
  lastTickNumber Int      @default(0)
  lastActionAt   DateTime?
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, roomId, actionKey])
  @@index([playerId, roomId])
}

enum ItemType {
  WEAPON
  EQUIPMENT
  CONSUMABLE
  MISC
}

enum EquipSlot {
  MAIN_HAND
  OFF_HAND
  HEAD
  BODY
  HANDS
  FEET
  RING
  NECK
  MOUNT
  ARTIFACT
  COMPANION
}

enum WeaponCategory {
  MELEE
  RANGED
}
