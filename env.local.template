# Shared Supabase database connections
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_PATH=/socket.io

# JWT secret for token signing/verification (generate a secure random string)
# Reuse this same value across environments if you want token continuity
# Generate with: openssl rand -base64 32
# Required for socket and API authentication
JWT_SECRET="your-secret-key-change-in-production"

# Runtime connection (goes through Supabase's PgBouncer pooler)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection required for Prisma migrations (bypasses PgBouncer)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-1-us-east-1.pooler.supabase.com:5432/postgres"

# Example production values (override in your hosting provider)
# NEXT_PUBLIC_SOCKET_URL=https://your-app.fly.dev
# NEXT_PUBLIC_SOCKET_PATH=/socket.io
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-1-us-east-1.pooler.supabase.com:5432/postgres"

# Note: In production, token validation always runs against the server.
# The local shortcut (skipping server validation) is enabled only in non-production builds.

