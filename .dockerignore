# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Version control history. ~113MB that is uploaded as build context on every
# deploy and, because the runner stage ends with `COPY . .`, shipped inside the
# image as well. Nothing at runtime reads it.
.git
.gitignore
.github
.husky

# The original game is reference material only — never built, never served, and
# ~61MB. It is git-ignored but NOT docker-ignored, so it rode along in every image.
lg-DO NOT EDIT - ORIGINAL LG RPG GAME - FOR REFERENCE ONLY

# Illustrator design sources (~31MB). They are the origin of the sprite sheet,
# not an input to the build, and must never be served to players.
*.ai

# Local scratch and editor state
*.code-workspace
.vscode
.idea

# Docs — useful in the repo, dead weight in the image
*.md
!README.md

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated files (to prevent file watching conflicts)
/public/sprite-sheet.svg
/src/lib/icon-mappings.ts

/src/generated/prisma
