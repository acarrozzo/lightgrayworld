#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Generate sprite sheet before committing
echo "🎨 Generating sprite sheet..."
npm run generate-icons

# Regenerate the theme stylesheet so it cannot drift from the theme definitions
echo "🎨 Generating theme CSS..."
npm run generate-themes

# Add generated files to commit
git add public/sprite-sheet.svg src/lib/icon-mappings.ts src/app/generated-themes.css
