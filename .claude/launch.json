{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lg-dev",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NEXT_DIST_DIR=.next-preview",
        "NEXT_PUBLIC_SOCKET_URL=http://localhost:3100",
        "npm",
        "run",
        "dev"
      ],
      "port": 3100,
      "autoPort": true
    },
    {
      "name": "lg-mini",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "--directory",
        "public"
      ],
      "port": 4173
    }
  ],
  "autoVerify": false
}
