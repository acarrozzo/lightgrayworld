{
  "name": "new-game",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate-icons": "node scripts/generate-sprite-sheet.js",
    "watch-icons": "node scripts/watch-icons.js",
    "dev": "npm run generate-icons && npm run generate-themes && node server.js",
    "dev:turbo": "node scripts/dev-manager.js",
    "dev:watch": "node scripts/dev-manager.js --watch-icons",
    "dev:monitor": "node scripts/performance-monitor.js",
    "dev:clean": "rm -rf .next && npm run generate-icons && npm run generate-themes && node server.js",
    "dev:legacy": "npm run generate-icons && npm run generate-themes && node server.js",
    "dev:socket": "node socket-server.js",
    "dev:engine": "npm run generate-icons && npm run generate-themes && node --watch-path=src/lib/game-engine --watch-path=src/lib/game-data --watch-path=src/lib/services --watch-path=src/lib/socket-server-handlers.js server.js",
    "postinstall": "prisma generate",
    "build": "npm run validate && npm run generate-themes && node scripts/build-with-icons.js && next build",
    "start": "NODE_ENV=production node server.js",
    "start:socket": "NODE_ENV=production node socket-server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:engine": "tsc -p tsconfig.engine.json",
    "test": "node --import tsx --test \"test/*.test.js\" \"test/*.test.ts\"",
    "validate": "npm run validate-quests && npm run validate-world && npm run validate-themes",
    "validate-quests": "node scripts/validate-quests.js",
    "validate-world": "node scripts/validate-world.js",
    "check": "npm run validate && npm run typecheck && npm run lint && npm test",
    "generate-themes": "tsx scripts/generate-theme-css.ts",
    "validate-themes": "tsx scripts/validate-themes.ts"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.548.0",
    "next": "^15.5.7",
    "next-auth": "^4.24.11",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.7.10",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chokidar": "^4.0.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "^15.0.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
